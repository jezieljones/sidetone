# Core: use your own accounts. Run npm run setup to generate internal secrets.
# Public values are included in browser builds. Rebuild after changing them.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SIDETONE_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
# Written by the Convex CLI; never copy another installation's deployment.
CONVEX_DEPLOYMENT=
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
SIDETONE_POST_CALL_MODEL=gpt-5.4-mini
SIDETONE_SHARED_CHAT_MODEL=gpt-5.4-mini
SIDETONE_CALL_INTELLIGENCE_MODEL=gpt-5.4-mini
SIDETONE_CALL_INTELLIGENCE_PLANNER_MODEL=gpt-5.4-mini
SIDETONE_LIVE_SUPERVISOR_MODEL=gpt-5.4-mini
SIDETONE_LIVE_SPECIALIST_MODEL=gpt-5.4-mini
SIDETONE_LIVE_FAST_MODEL=gpt-5.4-mini
SIDETONE_NEXT_CALL_ADVICE_MODEL=gpt-5.4-mini
# Copy this same generated token to Convex and each enabled worker.
SIDETONE_WORKER_TOKEN=
# Local Inngest development. Production requires INNGEST_DEV=0 and real keys.
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Self-hosted defaults: no Stripe account, trials, or subscription limits.
SIDETONE_BILLING_ENABLED=false
# Optional phone capture; keep false until configuration and routing are ready.
SIDETONE_PHONE_ENABLED=false
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CALL_CONTROL_CONNECTION_ID=
SIDETONE_REALTIME_URL=
SIDETONE_STREAM_SHARED_SECRET=
# Per-call safety limit, in minutes. Does not impose a paid subscription.
SIDETONE_MAX_CALL_MINUTES=120
# Optional SMS. Voice calls do not require an SMS messaging profile.
SIDETONE_SMS_ENABLED=false
TELNYX_MESSAGING_PROFILE_ID=
SIDETONE_OWNER_SUMMARY_SMS_FROM_NUMBER=
# Optional meeting sources; these require separate provider setup.
SIDETONE_ZOOM_ENABLED=false
ZOOM_RTMS_CLIENT_ID=
ZOOM_RTMS_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
SIDETONE_VEXA_ENABLED=false
VEXA_API_BASE=
VEXA_API_KEY=
SIDETONE_DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Encryption key for optional OAuth credentials, generated by setup.
SIDETONE_INTEGRATION_SECRET_KEY=
SIDETONE_INTEGRATIONS_ENABLED=false
